{
  "name": "action-template",
  "version": "1.0.0",
  "private": true,
  "description": "A GitHub Action",
  "keywords": [
    "Actions",
    "node"
  ],
  "homepage": "https://github.com/joshmgross/action-template#readme",
  "bugs": {
    "url": "https://github.com/joshmgross/action-template/issues"
  },
  "license": "MIT",
  "author": "joshmgross",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshmgross/action-template.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "pack": "node esbuild.config.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint",
    "format": "oxfmt src package.json",
    "format-check": "oxfmt --check src package.json",
    "all": "npm run build && npm run format && npm run lint && npm run pack"
  },
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
